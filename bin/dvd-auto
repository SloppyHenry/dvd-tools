#!/usr/bin/env bash
# dvd-auto: DVD einlegen -> automatisch erkennen -> mit MakeMKV rippen ->
# mit NVENC/HandBrake verkleinern -> sauber benannt ablegen.
set -uo pipefail

# "readlink -f" gibt es unter macOS/BSD nicht - python3 (ohnehin Pflicht) als
# portabler Ersatz.
LIB_DIR="$(cd "$(dirname "$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")")/../lib/dvd-tools" && pwd)"
# shellcheck source=lib/dvd-tools/common.sh
source "$LIB_DIR/common.sh"

OUT_DIR="${1:-${DVD_TOOLS_OUTPUT_DIR:-$PWD}}"
DEFAULT_QUALITY=19
DRIVE="${DVD_AUTO_DRIVE:-}"     # z.B. /dev/sr0, leer = automatisch waehlen

need makemkvcon
need HandBrakeCLI
need mkvpropedit
need mkvmerge
need ffprobe
need python3
if is_macos; then
  command -v drutil >/dev/null 2>&1 || command -v diskutil >/dev/null 2>&1 \
    || { err "Weder 'drutil' noch 'diskutil' gefunden (zum Disc-Auswurf)."; exit 1; }
else
  need eject
fi

# Gesamtzahl der Phasen fuer die Schrittnummerierung in step().
# shellcheck disable=SC2034  # von step() in ui.sh gelesen
STEP_TOTAL=8

makemkv() { run_unbuffered makemkvcon "$@"; }

# Listet aktive optische Laufwerke: "index\tdevice\tlabel\tname"
list_drives() {
  makemkv -r --cache=1 info disc:9999 2>/dev/null | python3 -c '
import sys, csv
for raw in sys.stdin:
    raw = raw.strip()
    if not raw.startswith("DRV:"):
        continue
    fields = next(csv.reader([raw[4:]]))
    idx, state = fields[0], fields[1]
    name, label, dev = fields[4], fields[5], fields[6]
    if state == "256" or not dev:
        continue
    print(f"{idx}\t{dev}\t{label}\t{name}")
'
}

# Kurze, sprechende Beschreibung einer Laufwerkszeile fuer die Auswahl.
describe_drive() {
  local row="$1" dev label name desc
  dev="$(cut -f2 <<<"$row")"
  label="$(cut -f3 <<<"$row")"
  name="$(cut -f4 <<<"$row")"
  desc="$dev"
  [ -n "$name" ] && desc="$desc — $name"
  if [ -n "$label" ]; then
    desc="$desc (Disc eingelegt: \"$label\")"
  elif [[ "$name" == *CDEmu* || "$name" == *virtual* ]]; then
    desc="$desc (virtuelles Laufwerk, kein Medium)"
  else
    desc="$desc (kein Medium eingelegt)"
  fi
  echo "$desc"
}

TMP_ROOT="$(mktemp -d /tmp/dvd-auto.XXXXXX)"
KEEP_RIP=0
cleanup() { [ "$KEEP_RIP" -eq 1 ] || rm -rf "$TMP_ROOT"; }
trap cleanup EXIT

header "dvd-auto" "DVD rippen, verkleinern und sauber ablegen"
echo
kv "Ausgabe" "$OUT_DIR"

# ---------- Laufwerk waehlen ----------
step "Laufwerk suchen"
mapfile -t DRIVES < <(list_drives)
if [ "${#DRIVES[@]}" -eq 0 ]; then
  err "Kein optisches Laufwerk gefunden."
  exit 1
fi

CHOSEN_ROW=""
if [ -n "$DRIVE" ]; then
  MK_INDEX=""
  for row in "${DRIVES[@]}"; do
    dev="$(cut -f2 <<<"$row")"
    [ "$dev" = "$DRIVE" ] && { MK_INDEX="$(cut -f1 <<<"$row")"; CHOSEN_ROW="$row"; }
  done
  [ -z "$MK_INDEX" ] && { err "Laufwerk $DRIVE nicht gefunden."; exit 1; }
elif [ "${#DRIVES[@]}" -eq 1 ]; then
  CHOSEN_ROW="${DRIVES[0]}"
  MK_INDEX="$(cut -f1 <<<"$CHOSEN_ROW")"
  DRIVE="$(cut -f2 <<<"$CHOSEN_ROW")"
else
  info "Mehrere Laufwerke gefunden:"
  # Vorauswahl ist das erste Laufwerk mit eingelegter Disc - liegt die DVD
  # schon drin, ist Enter dann die richtige Antwort. Sonst das erste.
  DEFAULT_CHOICE=1
  FOUND_DISC=0
  for i in "${!DRIVES[@]}"; do
    if [ "$FOUND_DISC" -eq 0 ] && [ -n "$(cut -f3 <<<"${DRIVES[$i]}")" ]; then
      DEFAULT_CHOICE=$((i+1)); FOUND_DISC=1
    fi
    menu_item "$((i+1))" "$(describe_drive "${DRIVES[$i]}")"
  done
  echo
  ask DCHOICE "Welches Laufwerk verwenden?" "$DEFAULT_CHOICE"
  if ! [[ "$DCHOICE" =~ ^[0-9]+$ ]] || [ "$DCHOICE" -lt 1 ] || [ "$DCHOICE" -gt "${#DRIVES[@]}" ]; then
    err "Ungueltige Auswahl."
    exit 1
  fi
  CHOSEN_ROW="${DRIVES[$((DCHOICE-1))]}"
  MK_INDEX="$(cut -f1 <<<"$CHOSEN_ROW")"
  DRIVE="$(cut -f2 <<<"$CHOSEN_ROW")"
fi
ok "Laufwerk: $(describe_drive "$CHOSEN_ROW")"

# ---------- Auf Disc warten ----------
step "Auf Disc warten"
info "Bitte DVD jetzt in $DRIVE einlegen."
# Nutzt MakeMKVs eigene Laufwerksliste statt "blkid" (Linux-spezifisch,
# gibt es unter macOS nicht) - funktioniert dadurch auf beiden Plattformen
# identisch.
DISC_LABEL=""
while true; do
  DISC_LABEL="$(list_drives | awk -F'\t' -v d="$DRIVE" '$2==d{print $3}')"
  [ -n "$DISC_LABEL" ] && break
  spinner_line "warte auf Disc in $DRIVE ..."
  sleep 2
done
progress_done
ok "Disc erkannt: $DISC_LABEL"

# ---------- Titel automatisch erkennen (setzt TITLE/YEAR/TMDBID) ----------
step "Film bestimmen"
identify_from_label "$DISC_LABEL"
[ -z "$TITLE" ] && { err "Titel darf nicht leer sein."; exit 1; }

SAFE_BASENAME="$(build_basename "$TITLE" "$YEAR" "$TMDBID")"
OUT_FOLDER="${OUT_DIR}/${SAFE_BASENAME}"
OUT="${OUT_FOLDER}/${SAFE_BASENAME}.mkv"
if [ -e "$OUT" ]; then
  warn "Zieldatei existiert bereits: $OUT"
  confirm "Ueberschreiben?" || { info "Abgebrochen."; exit 1; }
fi

# ---------- Rippen ----------
step "Disc rippen (MakeMKV)"
info "Das kann je nach Disc und Laufwerk einige Minuten dauern."
RIP_DIR="$TMP_ROOT/rip"
mkdir -p "$RIP_DIR"

rip_main_feature "$MK_INDEX" "$DRIVE" "$RIP_DIR" || warn "Rippen meldete einen Fehlercode - pruefe unten, ob Titel entstanden sind."

mapfile -t RIPPED < <(find "$RIP_DIR" -maxdepth 1 -iname "*.mkv" | sort)
if [ "${#RIPPED[@]}" -eq 0 ]; then
  err "MakeMKV hat keine Titel erzeugt. Ist die Disc lesbar / das Laufwerk frei (nicht durch die MakeMKV-GUI belegt)?"
  exit 1
fi

# Groesste Datei = Hauptfilm; Rest sind vermutlich Extras.
MAIN=""
MAIN_SIZE=0
for f in "${RIPPED[@]}"; do
  sz=$(file_size_bytes "$f")
  if [ "$sz" -gt "$MAIN_SIZE" ]; then MAIN="$f"; MAIN_SIZE=$sz; fi
done
ok "Hauptfilm: $(basename "$MAIN") ($(human_bytes "$MAIN_SIZE"))"
if [ "${#RIPPED[@]}" -gt 1 ]; then
  info "$(( ${#RIPPED[@]} - 1 )) weitere Titel (vermutlich Extras) bleiben unangetastet in: $RIP_DIR"
fi

step "Disc auswerfen"
if eject_disc "$DRIVE"; then
  ok "Disc ausgeworfen."
else
  warn "Auswerfen fehlgeschlagen (manuell entnehmen)."
fi

# ---------- Qualitaet ermitteln ----------
step "Rip analysieren"
SUGGESTION="$(suggest_quality "$MAIN")"
SUGGESTED_CQ="$(cut -f1 <<<"$SUGGESTION")"
ANALYSIS_INFO="$(cut -f2 <<<"$SUGGESTION")"
if [[ "$SUGGESTED_CQ" =~ ^[0-9]+$ ]]; then
  info "$ANALYSIS_INFO"
else
  warn "Analyse fehlgeschlagen, verwende Standardwert."
  SUGGESTED_CQ="$DEFAULT_QUALITY"
fi
echo
ask QUALITY "Qualitaet CQ (kleiner = besser)" "$SUGGESTED_CQ"
if ! [[ "$QUALITY" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  err "Ungueltiger Qualitaetswert."
  exit 1
fi

mkdir -p "$OUT_FOLDER"
DETECTED_ENCODER="$(pick_hevc_encoder)"

step "Encoding (HandBrakeCLI)"
hr
kv "Quelle" "$(basename "$MAIN")"
kv "Ziel" "$OUT"
kv "Encoder" "$DETECTED_ENCODER ${G_DOT} CQ $QUALITY"
kv "Spuren" "alle Ton-/Untertitelspuren unveraendert (Copy)"
hr
encode_to_hevc "$MAIN" "$OUT" "$QUALITY"
ok "Encoding abgeschlossen."

step "Datei taggen"
tag_mkv "$OUT" "$TITLE" "$YEAR"
ok "Tagging abgeschlossen."

header "Fertig" "$TITLE${YEAR:+ ($YEAR)}"
echo
kv "Groesse" "$(size_summary "$MAIN_SIZE" "$(file_size_bytes "$OUT")")"
kv_full "Datei" "$OUT"
echo

if confirm "Temporaeren Rip loeschen ($RIP_DIR)?"; then
  rm -rf "$RIP_DIR"
  ok "Temporaerer Rip geloescht."
else
  KEEP_RIP=1
  info "Temporaerer Rip bleibt erhalten: $RIP_DIR"
fi
