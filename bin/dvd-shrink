#!/usr/bin/env bash
# dvd-shrink: vorhandenen DVD-MKV-Rip auswaehlen, mit NVENC (HEVC) verkleinern,
# alle Ton-/Untertitelspuren behalten, sauber benennen/taggen.
set -euo pipefail

# "readlink -f" gibt es unter macOS/BSD nicht - python3 (ohnehin Pflicht) als
# portabler Ersatz.
LIB_DIR="$(cd "$(dirname "$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")")/../lib/dvd-tools" && pwd)"
# shellcheck source=lib/dvd-tools/common.sh
source "$LIB_DIR/common.sh"

DIR="${1:-${DVD_TOOLS_OUTPUT_DIR:-$PWD}}"
DEFAULT_QUALITY=19
# Gesamtzahl der Phasen fuer die Schrittnummerierung in step().
# shellcheck disable=SC2034  # von step() in ui.sh gelesen
STEP_TOTAL=4

need HandBrakeCLI
need mkvpropedit
need mkvmerge
need ffprobe
need python3

header "dvd-shrink" "Vorhandenen Rip verkleinern und sauber ablegen"
echo
kv "Ordner" "$DIR"

step "Datei waehlen"
mapfile -t FILES < <(find "$DIR" -maxdepth 1 -type f -iname "*.mkv" | sort)

if [ "${#FILES[@]}" -eq 0 ]; then
  err "Keine .mkv-Dateien in $DIR gefunden."
  exit 1
fi

info "Gefundene Dateien:"
for i in "${!FILES[@]}"; do
  menu_item "$((i+1))" "$(basename "${FILES[$i]}")" \
    "$(printf '%8s' "$(human_bytes "$(file_size_bytes "${FILES[$i]}")")")"
done
echo

ask CHOICE "Welche Datei soll verarbeitet werden?" "1"
if ! [[ "$CHOICE" =~ ^[0-9]+$ ]] || [ "$CHOICE" -lt 1 ] || [ "$CHOICE" -gt "${#FILES[@]}" ]; then
  err "Ungueltige Auswahl."
  exit 1
fi
IN="${FILES[$((CHOICE-1))]}"
IN_SIZE="$(file_size_bytes "$IN")"
ok "Ausgewaehlt: $(basename "$IN") ($(human_bytes "$IN_SIZE"))"

step "Film benennen"
ask TITLE "Filmtitel (z.B. 'The Green Mile')"
[ -z "$TITLE" ] && { err "Titel darf nicht leer sein."; exit 1; }
ask YEAR "Erscheinungsjahr (optional)"
ask TMDBID "TMDB-ID (optional)"

step "Quelldatei analysieren"
SUGGESTION="$(suggest_quality "$IN")"
SUGGESTED_CQ="$(cut -f1 <<<"$SUGGESTION")"
ANALYSIS_INFO="$(cut -f2 <<<"$SUGGESTION")"
if [[ "$SUGGESTED_CQ" =~ ^[0-9]+$ ]]; then
  info "$ANALYSIS_INFO"
else
  warn "Analyse fehlgeschlagen, verwende Standardwert."
  SUGGESTED_CQ="$DEFAULT_QUALITY"
fi
echo
ask QUALITY "Qualitaet CQ (kleiner = besser)" "$SUGGESTED_CQ"
if ! [[ "$QUALITY" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  err "Ungueltiger Qualitaetswert."
  exit 1
fi

SAFE_BASENAME="$(build_basename "$TITLE" "$YEAR" "$TMDBID")"
OUT_FOLDER="${DIR}/${SAFE_BASENAME}"
OUT="${OUT_FOLDER}/${SAFE_BASENAME}.mkv"

if [ -e "$OUT" ]; then
  warn "Zieldatei existiert bereits: $OUT"
  confirm "Ueberschreiben?" || { info "Abgebrochen."; exit 1; }
fi
mkdir -p "$OUT_FOLDER"
DETECTED_ENCODER="$(pick_hevc_encoder)"

step "Encoding (HandBrakeCLI)"
hr
kv "Quelle" "$(basename "$IN")"
kv "Ziel" "$OUT"
kv "Encoder" "$DETECTED_ENCODER ${G_DOT} CQ $QUALITY"
kv "Spuren" "alle Ton-/Untertitelspuren unveraendert (Copy)"
hr
echo
confirm "Starten?" || { info "Abgebrochen."; exit 1; }
echo
encode_to_hevc "$IN" "$OUT" "$QUALITY"
ok "Encoding abgeschlossen."
tag_mkv "$OUT" "$TITLE" "$YEAR"
ok "Tagging abgeschlossen."

header "Fertig" "$TITLE${YEAR:+ ($YEAR)}"
echo
kv "Groesse" "$(size_summary "$IN_SIZE" "$(file_size_bytes "$OUT")")"
kv_full "Datei" "$OUT"
echo

if confirm "Original-Datei '$(basename "$IN")' loeschen?"; then
  rm -f "$IN"
  ok "Original geloescht."
else
  info "Original wurde behalten."
fi
